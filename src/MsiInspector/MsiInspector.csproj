<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MsiInspector</AssemblyName>
    <RootNamespace>MsiInspector</RootNamespace>
    <Product>MSI Inspector</Product>
    <Version>1.0.0</Version>

    <!-- Lets the app be compiled on a Mac; it still only runs on Windows -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
  </PropertyGroup>

  <!-- When publishing for Windows (dotnet publish -r win-x64): one self-contained .exe coworkers can just run -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

</Project>
